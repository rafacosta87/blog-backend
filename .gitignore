# Dependências do Node (nunca enviar)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Variáveis de ambiente e segredos (protege suas senhas)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Banco de dados local (SQLite / Backups)
*.db
*.db-journal
/prisma/*.db
/prisma/*.db-journal


# Arquivos de Upload locais (imagens de teste que você põe no Postman)
src/public/uploads/*
# Se quiser manter a pasta uploads criada no Git mas ignorar as fotos, descomente a linha abaixo:
# !src/public/uploads/.gitkeep

# Builds e logs de execução
dist/
build/
logs
*.log

# Arquivos do sistema operacional e do editor de código
.DS_Store
.vscode/
.idea/
